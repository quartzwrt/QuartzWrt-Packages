#!/bin/sh /etc/rc.common
# quartz-screen — 小屏渲染守护进程（WP-16）
# 仅在有 framebuffer 或背光设备的机型上启动；其余机型安装后保持静默。

START=95
STOP=10
USE_PROCD=1
PROG=/usr/sbin/quartz-screen

has_screen() {
	ls /dev/fb* >/dev/null 2>&1 && return 0
	ls -d /sys/class/leds/*backlight* >/dev/null 2>&1 && return 0
	ls -d /sys/class/backlight/* >/dev/null 2>&1 && return 0
	return 1
}

start_service() {
	config_load quartz-screen
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	has_screen || return 0

	# 小屏由 quartz-screen 独占：解绑 fbcon，避免控制台内容盖在帧上
	for v in /sys/class/vtconsole/vtcon*; do
		case "$(cat "$v/name" 2>/dev/null)" in
			*frame?buffer*) echo 0 > "$v/bind" 2>/dev/null ;;
		esac
	done

	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/quartz-screen.pid
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "quartz-screen"
}

reload_service() {
	local pid
	pid="$(cat /var/run/quartz-screen.pid 2>/dev/null)"
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		kill -HUP "$pid"
	else
		start
	fi
}

stop_service() {
	local br
	for br in /sys/class/leds/*backlight*/brightness /sys/class/backlight/*/brightness; do
		[ -e "$br" ] && echo 0 > "$br" 2>/dev/null
	done
}
