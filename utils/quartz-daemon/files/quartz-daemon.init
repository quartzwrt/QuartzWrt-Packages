#!/bin/sh /etc/rc.common
# quartz-daemon — procd 服务脚本（WP-4 / DESIGN §7.2）
# START=95：网络就绪后启动（慢刷首轮即有 WAN 明细）；采集器对 ubus/网络/docker
# 缺失均容错，启动顺序不敏感。配置变更（uci commit quartz-daemon）经
# reload trigger 重启进程重读配置。

USE_PROCD=1
START=95
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/quartz-daemon
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "quartz-daemon"
}
