{
	"luci-app-quartz-screen": {
		"description": "Grant access to QuartzWrt small screen status, preview and settings",
		"read": {
			"uci": [ "quartz-screen" ],
			"file": {
				"/usr/sbin/quartz-screen status": [ "exec" ],
				"/usr/sbin/quartz-screen preview *": [ "exec" ],
				"/var/run/quartz-screen.json": [ "read" ]
			}
		},
		"write": {
			"uci": [ "quartz-screen" ],
			"file": {
				"/usr/sbin/quartz-screen apply": [ "exec" ],
				"/usr/sbin/quartz-screen test": [ "exec" ]
			}
		}
	}
}
