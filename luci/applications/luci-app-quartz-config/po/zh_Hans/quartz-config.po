msgid ""
msgstr ""
"Project-Id-Version: luci-app-quartz-config\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Quartz Theme"
msgstr "Quartz 主题"

msgid "Appearance options for the QuartzWrt LuCI theme. Changes take effect on the next page load."
msgstr "QuartzWrt LuCI 主题的外观选项，保存后在下次页面加载时生效。"

msgid "Appearance"
msgstr "外观"

msgid "The whole interface turns translucent when opacity is below 100%; content panels additionally get a backdrop blur."
msgstr "不透明度低于 100% 时整个界面（含侧边栏与顶栏）转为半透明，内容面板同时自动启用毛玻璃。"

msgid "Interface opacity"
msgstr "界面不透明度"

msgid "Opacity of content sections, the sidebar and the top bar, in percent. Lower values let the wallpaper show through."
msgstr "内容区段、侧边栏与顶栏的透明度（百分比），数值越低壁纸透出越明显。"

msgid "Blur strength"
msgstr "模糊强度"

msgid "Backdrop blur for the sidebar, top bar and translucent panels, in pixels."
msgstr "侧边栏、顶栏与半透明面板的背景模糊量（像素）。"

msgid "Default appearance"
msgstr "默认外观"

msgid "Applied to first-time visitors; a choice made in the browser overrides it."
msgstr "首次访问时采用的默认外观；在浏览器中手动选择过则以手动为准。"

msgid "Follow system"
msgstr "跟随系统"

msgid "Dark"
msgstr "深色"

msgid "Light"
msgstr "浅色"

msgid "Wallpaper"
msgstr "壁纸"

msgid "A single image used as the desktop background, shown below the translucent panels. It is stored on the device and takes effect immediately, without saving this form."
msgstr "用作桌面背景的单张图片，显示在半透明面板之下。保存在设备上，上传后立即生效，无需保存本表单。"

msgid "No custom wallpaper — the default quartz noise texture is used."
msgstr "未设置自备壁纸——当前使用 QuartzWrt 默认石英噪点纹理。"

msgid "Choose image…"
msgstr "选择图片…"

msgid "Uploads are re-encoded in the browser: longest side capped at 1920 px, converted to JPEG, at most 2 MB. Devices showing the old image may need a hard refresh."
msgstr "上传会在浏览器内重编码：最长边 1920 px、转 JPEG、不超过 2 MB。仍显示旧图的其他设备可能需要强制刷新。"

msgid "Stored at %s on the device, independent of the theme package; it survives package updates."
msgstr "保存在设备上的 %s，独立于主题包，随包升级不会被覆盖。"

msgid "Current: %s, updated %s."
msgstr "当前：%s，更新于 %s。"

msgid "Current: %dx%d px, %s, updated %s."
msgstr "当前：%dx%d px，%s，更新于 %s。"

msgid "Current: %dx%d px, %s, just uploaded."
msgstr "当前：%dx%d px，%s，刚刚上传。"

msgid "Unable to read the wallpaper file: %s"
msgstr "读取壁纸文件失败：%s"

msgid "Uploading wallpaper…"
msgstr "正在上传壁纸…"

msgid "Wallpaper updated."
msgstr "壁纸已更新。"

msgid "Wallpaper upload failed: %s"
msgstr "壁纸上传失败：%s"

msgid "Upload request failed"
msgstr "上传请求失败"

msgid "Remove"
msgstr "移除"

msgid "Remove wallpaper"
msgstr "移除壁纸"

msgid "The uploaded wallpaper will be deleted from the device. QuartzWrt falls back to the default quartz noise texture."
msgstr "已上传的壁纸将从设备上删除，QuartzWrt 回退到默认石英噪点纹理。"

msgid "Cancel"
msgstr "取消"

msgid "Wallpaper removed."
msgstr "壁纸已移除。"

msgid "Failed to remove the wallpaper: %s"
msgstr "移除壁纸失败：%s"

msgid "No file selected."
msgstr "未选择文件。"

msgid "The selected file is not a decodable image."
msgstr "所选文件不是可解码的图片。"

msgid "Failed to encode the wallpaper image."
msgstr "壁纸图片编码失败。"

msgid "Please choose an image file (JPEG, PNG or WebP)."
msgstr "请选择图片文件（JPEG、PNG 或 WebP）。"

msgid "The source image exceeds %s and will not be processed."
msgstr "源图超过 %s，不予处理。"

msgid "The image is still larger than %s after re-encoding; please pick a simpler image."
msgstr "重编码后图片仍大于 %s，请换一张更简单的图片。"
