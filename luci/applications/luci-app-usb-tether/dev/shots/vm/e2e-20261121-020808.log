wait_reload() {
	local i ev av
	for i in $(seq 1 10); do
		ev="$(uci -q get usb-tether.config.enabled)"
		av="$(uci -q get network.usb_tether.auto)"
		[ "$ev" = "$1" ] && [ "$av" = "$2" ] && return 0
		sleep 1
	done
	return 1
}
