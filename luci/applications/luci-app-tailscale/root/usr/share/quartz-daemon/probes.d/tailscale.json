    "dns_name": { "type": "exec", "path": "/usr/sbin/tailscale_probe", "args": ["dns_name"], "cache": 300 },
    "backend_state": { "type": "exec", "path": "/usr/sbin/tailscale_probe", "args": ["backend_state"], "cache": 300 },
    "peers_online": { "type": "exec", "path": "/usr/sbin/tailscale_probe", "args": ["peers_online"], "cache": 300 }
  }
}
