# ===== 壳层（view/quartz/dashboard.js） =====
# 命名：不得译作"概览"——基座 luci-mod-status 的 admin/status/overview 已占用"概览"
# （base.po: msgid "Overview"），同名会让侧边栏出现两个"概览"（2026-10-14 用户实测反馈）
msgid "Dashboard"
msgstr "仪表盘"

msgid "Dashboard bundle is missing"
msgstr "Dashboard 产物缺失"

msgid "This is a development state: build src/ and commit the bundle to htdocs/luci-static/resources/quartz-dashboard/ (see docs/DESIGN.md §4)."
msgstr "这是开发态：请构建 src/ 并把产物提交到 htdocs/luci-static/resources/quartz-dashboard/（见 docs/DESIGN.md §4）。"

msgid "Dashboard failed to render"
msgstr "Dashboard 渲染失败"

msgid "Bundle entry point window.QuartzDashboard.mount() is missing."
msgstr "产物未导出挂载入口 window.QuartzDashboard.mount()。"

# ===== 页面骨架（App.vue） =====
msgid "Collector is not running"
msgstr "采集器未运行"

msgid "is missing — quartz-daemon is not started or not installed. Retrying automatically every 5 seconds."
msgstr "不存在——quartz-daemon 未启动或未安装。页面每 5 秒自动重试，daemon 就绪后无需刷新。"

msgid "Collector data is corrupted"
msgstr "采集器数据损坏"

msgid "The status snapshot could not be parsed. Waiting for the next collection to overwrite it."
msgstr "状态快照解析失败，等待下一次采集覆盖；页面不会白屏。"

msgid "Waiting for data"
msgstr "等待数据"

msgid "Card failed to render"
msgstr "此卡渲染失败（已隔离）"

msgid "just now"
msgstr "刚刚"

msgid "min ago"
msgstr "分钟前"

msgid "h ago"
msgstr "小时前"

msgid "d ago"
msgstr "天前"

