{#
 luci-theme-quartz — header 模板（含侧边栏骨架）
 结构基于 luci-theme-bootstrap (Apache-2.0) 适配：固定侧边栏 + 顶栏 chrome 布局。
 设计规范: docs/DESIGN.md
-#}

{%
	import { getuid, getspnam } from 'luci.core';
	import { cursor } from 'uci';

	const boardinfo = ubus.call('system', 'board');

	/* 主题可配置项（luci-app-quartz-config 维护 /etc/config/quartz；
	 * 未安装配置包或读取失败时退回默认值） */
	const num = (v, d) => { const n = +v; return n === n ? n : d; };
	let panel_opacity = 100, blur = 20, default_mode = 'auto';
	try {
		const t = cursor().get_all('quartz', 'theme');
		panel_opacity = t.panel_opacity ? num(t.panel_opacity, 100) : 100;
		blur = (t.blur != null && t.blur !== '') ? num(t.blur, 20) : 20;
		if (t.default_mode === 'dark' || t.default_mode === 'light')
			default_mode = t.default_mode;
	} catch (e) {}
	/* ucode 的 Math 对象为空（25.12 基座实测），不能用 Math.max/min */
	const clamp = (v, lo, hi) => v < lo ? lo : (v > hi ? hi : v);
	panel_opacity = clamp(panel_opacity, 50, 100);
	blur = clamp(blur, 0, 40);
	const alpha = panel_opacity / 100;

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-qz-default="{{ default_mode }}"{{ alpha < 1 ? ' data-qz-translucent' : '' }}>
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<script>
			/* 首绘前定外观，避免闪烁：localStorage 手动选择优先 → 管理端默认外观 → 跟随系统（详见 theme.js） */
			(function () {
				var r = document.documentElement;
				var p = null;
				try { p = localStorage.getItem('qz-theme'); } catch (e) {}
				var d = r.getAttribute('data-qz-default') || 'auto';
				if (!p && d !== 'auto') p = d;
				var dark = (p === 'dark') ||
					(p !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				r.setAttribute('data-darkmode', dark ? 'true' : 'false');
				r.setAttribute('data-qz-mode', (p === 'dark' || p === 'light') ? p : 'auto');
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		<meta name="theme-color" content="#ececf0" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#1c1c1e" media="(prefers-color-scheme: dark)">
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		<style>:root { --qz-panel-alpha: {{ alpha }}; --qz-blur: {{ blur }}px; }</style>
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any" type="image/svg+xml">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
		<script src="{{ media }}/theme.js" defer></script>
	</head>

	<body class="lang_{{ dispatcher.lang }} {{ entityencode(striptags(node?.title ?? ''), true) }}{{ blank_page ? ' qz-blank' : '' }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<div id="qz-nav-veil"></div>
		<nav id="qz-sidebar">
			<a class="brand" href="/">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 2 L20 6.6 V17.4 L12 22 L4 17.4 V6.6 Z"/>
					<path d="M4 6.6 L12 11.6 L20 6.6"/>
					<path d="M12 11.6 V22" opacity=".45"/>
				</svg>
				<span>{{ striptags(boardinfo.hostname ?? 'QuartzWrt') }}</span>
			</a>
			<div class="qz-nav" id="qz-nav"></div>
			<div class="qz-sidebar-foot" style="display:none">
				<ul class="qz-modes" id="modemenu"></ul>
			</div>
		</nav>
		<header>
			<button type="button" id="qz-nav-toggle" class="qz-icon-btn" aria-label="{{ _('Menu') }}">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"/>
				</svg>
			</button>
			<div id="indicators" class="pull-right"></div>
			<button type="button" id="qz-theme-toggle" class="qz-icon-btn" aria-label="{{ _('Appearance') }}">
				<svg class="qz-i-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
					<circle cx="12" cy="12" r="8.5"/>
					<path d="M12 3.5v17a8.5 8.5 0 0 0 0-17Z" fill="currentColor" stroke="none"/>
				</svg>
				<svg class="qz-i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
					<path d="M20 13.5A8 8 0 1 1 10.5 4a6.5 6.5 0 0 0 9.5 9.5Z"/>
				</svg>
				<svg class="qz-i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4.5"/>
					<path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"/>
				</svg>
			</button>
		</header>

		<div id="maincontent" class="container">
			{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
				<div class="alert-message warning">
					<h4>{{ _('No password set!') }}</h4>
					<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
					{% if (dispatcher.lookup("admin/system/admin")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			{% if (boardinfo.rootfs_type == "initramfs"): %}
				<div class="alert-message warning">
					<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
					<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
					{% if (dispatcher.lookup("admin/system/flash")): %}
						<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			<noscript>
				<div class="alert-message warning">
					<h4>{{ _('JavaScript required!') }}</h4>
					<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
				</div>
			</noscript>

			<div id="tabmenu" style="display:none"></div>
		{% endif %}
