#!/bin/sh
# luci-theme-quartz: 注册主题并在全新安装时设为默认（升级不覆盖用户选择）
# 参考 luci-theme-bootstrap 的 30_luci-theme-bootstrap

changed=0

set_opt() {
	local key=$1
	local val=$2

	if ! uci -q get "luci.$key" 2>/dev/null; then
		uci set "luci.$key=$val"
		changed=1
	fi
}

set_opt themes.Quartz /luci-static/quartz

# 全新安装：强制设为默认主题。ImmortalWrt 出厂 /etc/config/luci 已预置
# mediaurlbase=bootstrap，"未设置才写"永远不会命中（2026-10-12 容器实测）；
# 升级（PKG_UPGRADE=1）时保留用户当前选择。
if [ "$PKG_UPGRADE" != 1 ]; then
	if [ "$(uci -q get luci.main.mediaurlbase)" != "/luci-static/quartz" ]; then
		uci set luci.main.mediaurlbase=/luci-static/quartz
		changed=1
	fi
fi

if [ $changed = 1 ]; then
	uci commit luci
fi

exit 0
